SIMBI_ENV=local
SIMBI_DATABASE_PATH=./data/simbi.db
SIMBI_FRONTEND_ORIGIN=http://localhost:5173
SIMBI_SESSION_HOURS=12
SIMBI_COOKIE_SECURE=false
SIMBI_RETENTION_DAYS=365
SIMBI_MAX_IMPORT_BYTES=1048576
SIMBI_ALLOWED_HOSTS=localhost,127.0.0.1
SIMBI_FORWARDED_ALLOW_IPS=127.0.0.1
SIMBI_MAX_FAILED_LOGINS=5
SIMBI_LOGIN_WINDOW_MINUTES=15
SIMBI_LOGIN_LOCK_MINUTES=15
SIMBI_AUTO_BACKUP=false
SIMBI_BACKUP_PATH=./backups
SIMBI_BACKUP_RETENTION_DAYS=30
# Optional HAI generic JSON feed. Message content remains excluded unless explicitly enabled.
SIMBI_HAI_FEED_PATH=
SIMBI_HAI_INCLUDE_CONTENT=false
# Optional outside production; a production first owner always needs an operator token.
SIMBI_SETUP_TOKEN=
# Supervised launchers and production Compose enable this automatically.
SIMBI_REQUIRE_MAINTENANCE=false
