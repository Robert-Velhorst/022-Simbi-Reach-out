SIMBI_DOMAIN=reachout.example.com
SIMBI_IMAGE_TAG=1.0.0
SIMBI_SESSION_HOURS=12
SIMBI_RETENTION_DAYS=365
SIMBI_BACKUP_RETENTION_DAYS=30
# Set a unique random 32-200 character secret before first-owner setup; no default owner/token.
SIMBI_SETUP_TOKEN=
# Optional private container feed destination: /app/hai/simbi.json
SIMBI_HAI_FEED_PATH=
SIMBI_HAI_INCLUDE_CONTENT=false
