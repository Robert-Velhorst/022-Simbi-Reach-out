FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f AS official
# Retain upstream default configuration and static assets. Build the binary
# separately so that the current stable Go toolchain and locked modules apply.

FROM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS edge-build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOENV=off GOWORK=off \
    GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org
WORKDIR /src
COPY edge/go.mod edge/go.sum ./
RUN go mod download all && go mod verify
COPY edge/main.go ./
RUN --network=none go build -mod=readonly -trimpath \
      -ldflags '-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7' \
      -o /out/caddy . \
    && go version -m /out/caddy > /out/build-info.txt \
    && go list -mod=readonly -deps . > /out/linked-packages.unsorted \
    && sort /out/linked-packages.unsorted > /out/linked-packages.txt \
    && rm /out/linked-packages.unsorted \
    && go env -json GOOS GOARCH CGO_ENABLED GOVERSION > /out/build-environment.json \
    && go list -m -f '{{if .Dir}}{{.Path}} {{.Dir}}{{end}}' all > /out/module-dirs.txt \
    && while read -r module directory; do \
         test -n "$directory" || continue; \
         mkdir -p "/out/licenses/$module"; \
         find "$directory" -maxdepth 1 -type f \( -iname 'LICENSE*' -o -iname 'NOTICE*' -o -iname 'COPYING*' \) \
           -exec cp '{}' "/out/licenses/$module/" \;; \
       done < /out/module-dirs.txt \
    && rm /out/module-dirs.txt \
    && cp go.mod go.sum /out/ \
    && cp "$(go env GOMODCACHE)/github.com/caddyserver/caddy/v2@v2.11.7/LICENSE" /out/LICENSE \
    && cd /out && sha256sum caddy build-info.txt linked-packages.txt \
      build-environment.json go.mod go.sum LICENSE > evidence.sha256

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates mailcap \
    && mkdir -p /config/caddy /data/caddy /etc/caddy /usr/share/caddy /srv \
    && chmod 1777 /config/caddy /data/caddy
COPY --from=edge-build /out/caddy /usr/bin/caddy
COPY --from=official /etc/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=official /usr/share/caddy /usr/share/caddy
COPY --from=edge-build /out/build-info.txt /out/linked-packages.txt \
    /out/build-environment.json /out/go.mod /out/go.sum /out/LICENSE \
    /out/evidence.sha256 /usr/share/caddy/build/
COPY --from=edge-build /out/licenses/ /usr/share/caddy/licenses/
RUN cd /usr/share/caddy/build \
    && sed 's#  caddy$#  /usr/bin/caddy#' evidence.sha256 | sha256sum -c - \
    && /usr/bin/caddy version
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
LABEL org.opencontainers.image.title="Simbi Caddy edge" \
      org.opencontainers.image.version="2.11.7" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Robert-Velhorst/022-Simbi-Reach-out"
EXPOSE 80 443 443/udp 2019
WORKDIR /srv
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
